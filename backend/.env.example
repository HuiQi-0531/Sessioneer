# Local Docker database
DATABASE_URL=postgresql://sessioneer:newSecurePass2026xyz@localhost:5433/sessioneer_db

# Backend port
PORT=5001

# Local development JWT secret
JWT_SECRET=replace_with_a_long_random_secret

# Password reset emails with Brevo Transactional API
BREVO_API_KEY=your_brevo_api_key
FRONTEND_URL=http://localhost:3000
EMAIL_FROM=Sessioneer <your_verified_sender_email@example.com>

# Supabase Storage for message photo/file attachments
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=message-attachments
SUPABASE_AVATAR_BUCKET=profile-avatars
